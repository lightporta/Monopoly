{
  "name": "yantai-monopoly",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "monopoly",
    "server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace=monopoly",
    "start": "npm start --workspace=server",
    "test": "node --test tests/*.test.js",
    "simulate": "node scripts/simulate.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "format": "prettier --write shared server scripts tests monopoly/src monopoly/index.html monopoly/vite.config.js package.json playwright.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
